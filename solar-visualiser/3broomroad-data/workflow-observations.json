    {
      "id": "rear-geometry",
      "targetId": "rear-roofs",
      "title": "Resolve rear roof and camera mismatch",
      "why": "Rear checks fail; incorrect junctions or dimensions invalidate photo-derived areas.",
      "method": "Confirm which edges belong to this house. Capture two rear views with overlapping corners, one known horizontal distance, both eave heights and garden/threshold level difference.",
      "fields": [
        {
          "key": "wingLow",
          "label": "Upper-wing low eave above house datum",
          "type": "number",
          "unit": "m",
          "min": 0,
          "max": 15,
          "required": true
        },
        {
          "key": "wingHigh",
          "label": "Upper-wing high eave above house datum",
          "type": "number",
          "unit": "m",
          "min": 0,
          "max": 15,
          "required": true
        },
        {
          "key": "extensionLow",
          "label": "Lower-extension low eave above datum",
          "type": "number",
          "unit": "m",
          "min": 0,
          "max": 10,
          "required": true
        },
        {
          "key": "extensionHigh",
          "label": "Lower-extension high eave above datum",
          "type": "number",
          "unit": "m",
          "min": 0,
          "max": 10,
          "required": true
        },
        {
          "key": "datum",
          "label": "Describe and photograph the common height datum",
          "type": "text",
          "required": true
        }
      ],
      "priority": "high",
      "role": "surveyor",
